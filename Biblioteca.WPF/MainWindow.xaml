<Window x:Class="Biblioteca.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca - Gestión de préstamos" Height="760" Width="1250"
        MinHeight="650" MinWidth="1050" WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="24,18">
            <StackPanel>
                <TextBlock Text="Biblioteca" FontSize="28" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Libros, socios, préstamos y devoluciones" Foreground="#DCEBFA" />
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <ProgressBar x:Name="busyBar" Width="120" Height="12" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="txtStatus" Text="Listo" Margin="10,0" />
        </StatusBar>

        <TabControl Margin="16">
            <TabItem Header="Libros">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBox x:Name="txtBuscarLibro" DockPanel.Dock="Top" TextChanged="txtBuscarLibro_TextChanged" ToolTip="Buscar por título o autor" />
                        <DataGrid x:Name="dgLibros" SelectionChanged="dgLibros_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*" />
                                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="125" />
                                <DataGridTextColumn Header="Autor" Binding="{Binding AutorNombre}" Width="180" />
                                <DataGridTextColumn Header="Ejemplares" Binding="{Binding Ejemplares}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="2" Background="White" Padding="20" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Datos del libro" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Título"/><TextBox x:Name="txtLibroTitulo" MaxLength="160"/>
                            <TextBlock Text="ISBN"/><TextBox x:Name="txtLibroISBN" MaxLength="20"/>
                            <TextBlock Text="Autor"/><ComboBox x:Name="cboAutores" DisplayMemberPath="Nombre" SelectedValuePath="AutorId"/>
                            <TextBlock Text="Ejemplares"/><TextBox x:Name="txtEjemplares" Text="1"/>
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="Nuevo" Click="btnNuevoLibro_Click"/>
                                <Button Content="Guardar" Click="btnGuardarLibro_Click" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                                <Button Content="Dar de baja" Click="btnEliminarLibro_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Socios">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBox x:Name="txtBuscarSocio" DockPanel.Dock="Top" TextChanged="txtBuscarSocio_TextChanged" ToolTip="Buscar por nombre o DNI" />
                        <DataGrid x:Name="dgSocios" SelectionChanged="dgSocios_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="110" />
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                                <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <Border Grid.Column="2" Background="White" Padding="20" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Datos del socio" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="DNI"/><TextBox x:Name="txtSocioDNI" MaxLength="8"/>
                            <TextBlock Text="Nombre"/><TextBox x:Name="txtSocioNombre" MaxLength="120"/>
                            <TextBlock Text="Correo"/><TextBox x:Name="txtSocioEmail" MaxLength="160"/>
                            <WrapPanel HorizontalAlignment="Right">
                                <Button Content="Nuevo" Click="btnNuevoSocio_Click"/>
                                <Button Content="Guardar" Click="btnGuardarSocio_Click" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                                <Button Content="Dar de baja" Click="btnEliminarSocio_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Préstamos y devoluciones">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" Padding="20" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Registrar préstamo" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Socio"/><ComboBox x:Name="cboSociosPrestamo" DisplayMemberPath="Nombre" SelectedValuePath="SocioId"/>
                            <TextBlock Text="Libro disponible"/><ComboBox x:Name="cboLibrosDisponibles" DisplayMemberPath="Titulo" SelectedValuePath="LibroId"/>
                            <Button Content="Agregar libro" Click="btnAgregarLibro_Click" HorizontalAlignment="Left"/>
                            <DataGrid x:Name="dgLibrosPrestamo" Height="150" ItemsSource="{Binding LibrosSeleccionados}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Libro seleccionado" Binding="{Binding Titulo}" Width="*"/>
                                    <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Quitar seleccionado" Click="btnQuitarLibro_Click" HorizontalAlignment="Left"/>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Fecha préstamo"/><DatePicker x:Name="dpFechaPrestamo"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Fecha límite"/><DatePicker x:Name="dpFechaLimite"/></StackPanel>
                            </Grid>
                            <Button Content="Registrar préstamo" Click="btnRegistrarPrestamo_Click" Background="{StaticResource PrimaryBrush}" Foreground="White" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" Padding="20" CornerRadius="8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Libros pendientes de devolución" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="La multa es S/ 1.50 por cada día de retraso." Foreground="#555" Margin="0,4,0,12"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Bottom" Content="Registrar devolución seleccionada" Click="btnDevolver_Click" HorizontalAlignment="Right" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                            <DataGrid x:Name="dgPendientes">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Préstamo" Binding="{Binding PrestamoId}" Width="75"/>
                                    <DataGridTextColumn Header="Socio" Binding="{Binding SocioNombre}" Width="*"/>
                                    <DataGridTextColumn Header="Libro" Binding="{Binding LibroTitulo}" Width="*"/>
                                    <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=d}" Width="105"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Reporte">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Background="White" Padding="14" CornerRadius="8" Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="dpReporteDesde" Width="150" Margin="0,0,16,0"/>
                            <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="dpReporteHasta" Width="150" Margin="0,0,16,0"/>
                            <Button Content="Consultar" Click="btnConsultarReporte_Click" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="dgReporte">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N.º" Binding="{Binding PrestamoId}" Width="65"/>
                            <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="*"/>
                            <DataGridTextColumn Header="Libro" Binding="{Binding Libro}" Width="*"/>
                            <DataGridTextColumn Header="Préstamo" Binding="{Binding FechaPrestamo, StringFormat=d}" Width="105"/>
                            <DataGridTextColumn Header="Límite" Binding="{Binding FechaLimite, StringFormat=d}" Width="105"/>
                            <DataGridTextColumn Header="Devolución" Binding="{Binding FechaDevolucion, StringFormat=d}" Width="105"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
